# ==========================================================
# Plantilla de variables de entorno - LABFICAT Backend
# Copiar a .env y completar con los valores reales.
# El archivo .env NO se sube al repositorio.
# ==========================================================

# Servidor
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Base de datos (MongoDB Atlas)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/labficat?retryWrites=true&w=majority

# Seguridad / JWT
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Correo SMTP (Nodemailer)
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=labficat@ejemplo.com
MAIL_PASS=********
MAIL_FROM="LABFICAT <labficat@ejemplo.com>"
MAIL_TO_PRODUCCION=produccioncentro@ejemplo.com

# Parametros de negocio (valores por defecto, tambien en configuracion_sistema)
CUPON_VIGENCIA_DIAS=15
CUPON_UMBRAL_RECORDATORIO_DIAS=5
TOKEN_RECUPERACION_MINUTOS=30
